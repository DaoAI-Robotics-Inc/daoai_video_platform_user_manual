msgstr "transparency"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:46
msgid "遮罩叠加层的透明度（0~1）。"
msgstr "The transparency of the mask overlay (0~1)."

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:47
msgid "``0.3``"
msgstr "``0.3``"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:48
msgid "绘制轮廓"
msgstr "Draw outline"

