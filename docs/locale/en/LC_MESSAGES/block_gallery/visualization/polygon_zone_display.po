msgid "工作流中该节点的名称。"
msgstr "The name of this node in the workflow."

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:29
msgid "``polygon_zone_visualization_1``"
msgstr "``polygon_zone_visualization_1``"

