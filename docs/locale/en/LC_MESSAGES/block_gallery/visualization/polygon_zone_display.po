#: ../../source/block_gallery/visualization/polygon_zone_display.rst:4
msgid "多边形区域显示"
msgstr "Polygon area display"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:7
msgid "简介"
msgstr "Introduction"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:9
msgid "在图像中多边形区域上应用遮罩或绘制轮廓，可用于标记 ROI/禁区或叠加热力/遮罩效果。"
msgstr ""
"Apply a mask or draw an outline over a polygonal area in an image, which can"
" be used to mark ROI/no-go areas or overlay thermal/mask effects."

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:12
msgid "输入 / 输出"
msgstr "input/output"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:14
msgid "输入：图像 + 多边形区域列表"
msgstr "Input: image + list of polygonal regions"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:15
msgid "输出：叠加多边形区域（填充或轮廓）的图像"
msgstr "Output: Image with superimposed polygonal areas (filled or outlined)"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:18
msgid "配置参数"
msgstr "Configuration parameters"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:24
msgid "参数"
msgstr "parameter"

#: ../../source/block_gallery/visualization/polygon_zone_display.rst:25
