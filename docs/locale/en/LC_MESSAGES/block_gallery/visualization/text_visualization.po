msgid "区域"
msgstr "area"

#: ../../source/block_gallery/visualization/text_visualization.rst:58
msgid "可选多边形区域用于相对定位或裁剪，JSON 数组形式。"
msgstr ""
"Optional polygonal region for relative positioning or clipping, as JSON "
"array."

#: ../../source/block_gallery/visualization/text_visualization.rst:59
msgid "``[[0,0,0],[100,0,0],[0,100,100]]``"
msgstr "``[[0,0,0],[100,0,0],[0,100,100]]``"

#: ../../source/block_gallery/visualization/text_visualization.rst:60
msgid "文本大小"
msgstr "text size"

#: ../../source/block_gallery/visualization/text_visualization.rst:61
