msgstr "Input: - Image (from upstream node or workflow input)"

#: ../../source/block_gallery/visualization/text_visualization.rst:17
msgid "输出（Output）: - 叠加文本后的图像"
msgstr "Output: - Image with text superimposed"

#: ../../source/block_gallery/visualization/text_visualization.rst:21
msgid "配置参数详解"
