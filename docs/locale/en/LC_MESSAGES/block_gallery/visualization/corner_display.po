msgstr "Step name, a unique identifier used to identify this node"

#: ../../source/block_gallery/visualization/corner_display.rst:45
msgid "``corner_visualization_1``"
msgstr "``corner_visualization_1``"

#: ../../source/block_gallery/visualization/corner_display.rst:46
