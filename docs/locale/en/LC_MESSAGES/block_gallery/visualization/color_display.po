#: ../../source/block_gallery/visualization/color_display.rst:25
msgid "检测结果（包含区域、类别等信息）"
msgstr "Detection results (including region, category and other information)"

#: ../../source/block_gallery/visualization/color_display.rst:27
msgid "**输出**："
msgstr "**Output**:"

#: ../../source/block_gallery/visualization/color_display.rst:29
