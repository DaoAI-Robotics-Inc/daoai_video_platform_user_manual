msgstr "**Palette**"

#: ../../source/block_gallery/visualization/trace_display.rst:51
msgid "颜色调色板方案，用于为不同跟踪目标分配颜色"
msgstr ""
"Color palette scheme for assigning colors to different tracking targets"

#: ../../source/block_gallery/visualization/trace_display.rst:52
msgid "``DEFAULT``"
msgstr "``DEFAULT``"

#: ../../source/block_gallery/visualization/trace_display.rst:53
msgid "**调色板大小**"
msgstr "**Palette size**"

#: ../../source/block_gallery/visualization/trace_display.rst:54
