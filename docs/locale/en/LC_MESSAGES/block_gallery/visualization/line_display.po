#: ../../source/block_gallery/visualization/line_display.rst:4
msgid "线条计数显示"
msgstr "Line count display"

#: ../../source/block_gallery/visualization/line_display.rst:7
msgid "简介"
msgstr "Introduction"

#: ../../source/block_gallery/visualization/line_display.rst:9
msgid "在图像/视频上绘制计数线，统计目标穿过线段的次数，可用于越界/流量统计场景。"
msgstr ""
"Draw a counting line on the image/video to count the number of times the "
"target crosses the line segment, which can be used in cross-border/traffic "
"statistics scenarios."

#: ../../source/block_gallery/visualization/line_display.rst:12
msgid "输入 / 输出"
msgstr "input/output"

#: ../../source/block_gallery/visualization/line_display.rst:14
msgid "输入：图像 + 线段坐标"
msgstr "Input: image + line segment coordinates"

#: ../../source/block_gallery/visualization/line_display.rst:15
msgid "输出：叠加计数线和文本后的图像，以及计数结果"
msgstr ""
"Output: Image with counting lines and text superimposed, and counting "
"results"

