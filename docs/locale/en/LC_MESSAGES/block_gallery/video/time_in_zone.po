msgid "输入 / 输出"
msgstr "input/output"

#: ../../source/block_gallery/video/time_in_zone.rst:14
msgid "输入：检测/跟踪结果 + 区域坐标"
msgstr "Input: detection/tracking results + area coordinates"

#: ../../source/block_gallery/video/time_in_zone.rst:15
msgid "输出：区域内停留时长"
msgstr "Output: length of stay in the area"

#: ../../source/block_gallery/video/time_in_zone.rst:18
#: ../../source/block_gallery/video/time_in_zone.rst:24
msgid "参数"
msgstr "parameter"

#: ../../source/block_gallery/video/time_in_zone.rst:25
msgid "说明"
msgstr "illustrate"

