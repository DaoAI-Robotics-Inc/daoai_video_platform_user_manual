msgstr "Example/``DefaultValue``"

#: ../../source/block_gallery/video/time_in_zone.rst:27
msgid "节点名称"
msgstr "Node name"

#: ../../source/block_gallery/video/time_in_zone.rst:28
msgid "工作流中该节点的名称。"
msgstr "The name of this node in the workflow."

#: ../../source/block_gallery/video/time_in_zone.rst:29
msgid "``time_in_zone_1``"
msgstr "``time_in_zone_1``"

#: ../../source/block_gallery/video/time_in_zone.rst:30
msgid "备注"
msgstr "Remark"

#: ../../source/block_gallery/video/time_in_zone.rst:31
msgid "可选备注信息，记录用途。"
msgstr "Optional remark information to record the purpose."

#: ../../source/block_gallery/video/time_in_zone.rst:32
msgid "``留空``"
msgstr "``leave blank``"

#: ../../source/block_gallery/video/time_in_zone.rst:33
msgid "图像"
msgstr "image"

#: ../../source/block_gallery/video/time_in_zone.rst:34
msgid "本步骤的输入图像。"
msgstr "Input image for this step."

#: ../../source/block_gallery/video/time_in_zone.rst:35
msgid "``input.image``"
msgstr "``input.image``"

#: ../../source/block_gallery/video/time_in_zone.rst:36
msgid "检测"
msgstr "Detection"

#: ../../source/block_gallery/video/time_in_zone.rst:37
msgid "需要object tracker输出的检测结果。"
msgstr "The detection results output by the object tracker are required."

#: ../../source/block_gallery/video/time_in_zone.rst:38
msgid "选择上游检测/跟踪输出"
msgstr "Select upstream detection/trace output"

#: ../../source/block_gallery/video/time_in_zone.rst:39
msgid "区域"
msgstr "area"

#: ../../source/block_gallery/video/time_in_zone.rst:40
