msgid "``CENTER``"
msgstr "``CENTER``"

#: ../../source/block_gallery/video/time_in_zone.rst:45
msgid "移除区域外的检测结果"
msgstr "Remove detection results outside the zone"

#: ../../source/block_gallery/video/time_in_zone.rst:46
msgid "如果为真，在区域外发现的检测结果将被过滤。"
msgstr "If true, detections found outside the zone will be filtered."

#: ../../source/block_gallery/video/time_in_zone.rst:47
#: ../../source/block_gallery/video/time_in_zone.rst:50
msgid "``True``"
msgstr "``True``"

#: ../../source/block_gallery/video/time_in_zone.rst:48
msgid "离开区域时重置计时"
msgstr "Reset timer when leaving area"

#: ../../source/block_gallery/video/time_in_zone.rst:49
msgid "如果为真，在区域外发现的检测结果将重置时间。"
msgstr "If true, detections found outside the zone will reset the time."
