msgstr "input/output"

#: ../../source/block_gallery/video/line_counter.rst:14
msgid "输入：检测/跟踪结果 + 线条坐标"
msgstr "Input: detection/tracking results + line coordinates"

#: ../../source/block_gallery/video/line_counter.rst:15
msgid "输出：计数结果"
msgstr "Output: count result"

#: ../../source/block_gallery/video/line_counter.rst:18
