msgid "线条计数"
msgstr "line count"

#: ../../source/block_gallery/video/line_counter.rst:7
msgid "简介"
msgstr "Introduction"

#: ../../source/block_gallery/video/line_counter.rst:9
msgid "统计穿过线条的检测数量，可配置线段、计数判断点与检测源。"
msgstr ""
"Count the number of detections crossing the line, and configure the line "
"segments, counting judgment points and detection sources."

