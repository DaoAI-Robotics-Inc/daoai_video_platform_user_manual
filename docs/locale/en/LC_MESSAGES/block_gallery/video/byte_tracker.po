#: ../../source/block_gallery/video/byte_tracker.rst:4
msgid "物体追踪器"
msgstr "object tracker"

#: ../../source/block_gallery/video/byte_tracker.rst:7
msgid "简介"
msgstr "Introduction"

#: ../../source/block_gallery/video/byte_tracker.rst:9
msgid "通过多目标跟踪器在视频帧中为检测到的对象分配 ID 并持续跟踪，可用于高速公路、监控等场景的目标计数与轨迹分析。"
msgstr ""
"The multi-target tracker assigns IDs to detected objects in video frames and"
" continuously tracks them, which can be used for target counting and "
"trajectory analysis in highways, surveillance and other scenes."

#: ../../source/block_gallery/video/byte_tracker.rst:12
msgid "输入 / 输出"
msgstr "input/output"

#: ../../source/block_gallery/video/byte_tracker.rst:14
msgid "输入：视频帧 + 检测结果"
msgstr "Input: video frames + detection results"

#: ../../source/block_gallery/video/byte_tracker.rst:15
msgid "输出：带 ID 的跟踪结果"
msgstr "Output: Trace results with ID"

#: ../../source/block_gallery/video/byte_tracker.rst:18
#: ../../source/block_gallery/video/byte_tracker.rst:24
msgid "参数"
msgstr "parameter"

#: ../../source/block_gallery/video/byte_tracker.rst:25
msgid "说明"
msgstr "illustrate"

#: ../../source/block_gallery/video/byte_tracker.rst:26
msgid "示例/ ``默认值``"
msgstr "Example/``DefaultValue``"

#: ../../source/block_gallery/video/byte_tracker.rst:27
msgid "节点名称"
msgstr "Node name"

#: ../../source/block_gallery/video/byte_tracker.rst:28
msgid "工作流中该节点的名称。"
msgstr "The name of this node in the workflow."

#: ../../source/block_gallery/video/byte_tracker.rst:29
msgid "``highway_tracker_1``"
msgstr "``highway_tracker_1``"

#: ../../source/block_gallery/video/byte_tracker.rst:30
msgid "备注"
msgstr "Remark"

#: ../../source/block_gallery/video/byte_tracker.rst:31
msgid "可选备注信息，记录用途。"
msgstr "Optional remark information to record the purpose."

#: ../../source/block_gallery/video/byte_tracker.rst:32
msgid "``留空``"
msgstr "``leave blank``"

#: ../../source/block_gallery/video/byte_tracker.rst:33
msgid "Image"
msgstr "Image"

#: ../../source/block_gallery/video/byte_tracker.rst:34
msgid "输入图像来源。"
msgstr "Enter the image source."

#: ../../source/block_gallery/video/byte_tracker.rst:35
msgid "``input.image``"
msgstr "``input.image``"

#: ../../source/block_gallery/video/byte_tracker.rst:36
msgid "检测配置"
msgstr "Detect configuration"

#: ../../source/block_gallery/video/byte_tracker.rst:37
msgid "选择要跟踪的检测结果/目标。"
msgstr "Select detections/targets to track."

#: ../../source/block_gallery/video/byte_tracker.rst:38
msgid "选择上游检测输出"
msgstr "Select upstream detection output"

#: ../../source/block_gallery/video/byte_tracker.rst:39
msgid "轨迹激活阈值"
msgstr "Trajectory activation threshold"

#: ../../source/block_gallery/video/byte_tracker.rst:40
msgid "轨迹在场景中轨迹激活的置信度阈值，检测对象速度越快，该阈值应越低（范围0-1）。"
msgstr ""
"The confidence threshold for trajectory activation in the scene. The faster "
"the object is detected, the lower the threshold should be (range 0-1)."

#: ../../source/block_gallery/video/byte_tracker.rst:41
msgid "``0.25``"
msgstr "``0.25``"

#: ../../source/block_gallery/video/byte_tracker.rst:42
msgid "轨迹缓存丢失"
msgstr "Track cache lost"

#: ../../source/block_gallery/video/byte_tracker.rst:43
msgid "丢失轨迹时缓存的步数（帧数）。"
msgstr "Number of steps (frames) cached when losing track."

#: ../../source/block_gallery/video/byte_tracker.rst:44
#: ../../source/block_gallery/video/byte_tracker.rst:50
msgid "``1``"
msgstr "``1``"

#: ../../source/block_gallery/video/byte_tracker.rst:45
msgid "最低阈值"
msgstr "minimum threshold"

#: ../../source/block_gallery/video/byte_tracker.rst:46
msgid "过滤低置信度轨迹的阈值，同样检测对象速度越快，该阈值应越低（范围0-1）。"
msgstr ""
"The threshold for filtering low-confidence trajectories. Similarly, the "
"faster the object is detected, the lower the threshold should be (range "
"0-1)."

#: ../../source/block_gallery/video/byte_tracker.rst:47
msgid "``0.7``"
msgstr "``0.7``"

#: ../../source/block_gallery/video/byte_tracker.rst:48
msgid "最小连续帧数"
msgstr "Minimum number of consecutive frames"

#: ../../source/block_gallery/video/byte_tracker.rst:49
msgid "轨迹稳定所需的最少连续帧数。"
msgstr ""
"Minimum number of consecutive frames required for trajectory stability."

#: ../../source/block_gallery/video/byte_tracker.rst:51
msgid "启用人员重识别"
msgstr "Enable person re-identification"

#: ../../source/block_gallery/video/byte_tracker.rst:52
msgid "是否启用 ReID 以在遮挡/离开后恢复 ID。"
msgstr "Whether to enable ReID to recover ID after occlusion/leaving."

#: ../../source/block_gallery/video/byte_tracker.rst:53
msgid "``False``"
msgstr "``False``"

#: ../../source/block_gallery/video/byte_tracker.rst:54
msgid "IoU 匹配阈值"
msgstr "IoU match threshold"

#: ../../source/block_gallery/video/byte_tracker.rst:55
msgid "IoU 匹配阈值（0~1），仅在启用 ReID 时使用。"
msgstr "IoU matching threshold (0~1), only used when ReID is enabled."

#: ../../source/block_gallery/video/byte_tracker.rst:56
msgid "``0.5``"
msgstr "``0.5``"

#: ../../source/block_gallery/video/byte_tracker.rst:57
msgid "ReID 最小相似度"
msgstr "ReID minimum similarity"

#: ../../source/block_gallery/video/byte_tracker.rst:58
msgid "ReID 配对最小相似度阈值（0~1），仅在启用 ReID 时使用。"
msgstr ""
"ReID pairing minimum similarity threshold (0~1), only used when ReID is "
"enabled."

#: ../../source/block_gallery/video/byte_tracker.rst:59
msgid "``0.35``"
msgstr "``0.35``"

#: ../../source/block_gallery/video/byte_tracker.rst:60
msgid "实例缓存大小"
msgstr "Instance cache size"

#: ../../source/block_gallery/video/byte_tracker.rst:61
msgid "实例缓存容量，用于判别新实例或已见实例。"
msgstr ""
"Instance cache capacity, used to identify new instances or existing "
"instances."

#: ../../source/block_gallery/video/byte_tracker.rst:62
msgid "``16384``"
msgstr "``16384``"
