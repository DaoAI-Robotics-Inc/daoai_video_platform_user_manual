msgid "**置信度分数** (0~1之间的浮点数)"
msgstr "**Confidence score** (floating point number between 0~1)"

#: ../../source/block_gallery/models/daoai_world_instance_segmentation.rst:19
msgid "**分割掩码** (像素级的二值掩码或多边形轮廓)"
msgstr "**Segmentation Mask** (pixel-level binary mask or polygonal outline)"

