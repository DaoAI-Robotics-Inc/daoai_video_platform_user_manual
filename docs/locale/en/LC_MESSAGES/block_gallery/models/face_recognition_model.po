#: ../../source/block_gallery/models/face_recognition_model.rst:4
msgid "人脸识别模型"
msgstr "face recognition model"

#: ../../source/block_gallery/models/face_recognition_model.rst:7
msgid "简介"
msgstr "Introduction"

#: ../../source/block_gallery/models/face_recognition_model.rst:9
msgid "在图像中检测和识别人脸，并可基于已知人脸库进行身份匹配，适合门禁核验、考勤、访客登记等场景。"
msgstr ""
"Detect and recognize faces in images, and perform identity matching based on"
" known face databases, suitable for access control verification, attendance,"
" visitor registration and other scenarios."

#: ../../source/block_gallery/models/face_recognition_model.rst:12
msgid "输入/输出"
msgstr "input/output"

#: ../../source/block_gallery/models/face_recognition_model.rst:14
msgid "输入（Input）: - 图像 / 视频帧（来自上游节点或工作流输入）"
msgstr "Input: - Image/video frame (from upstream node or workflow input)"

#: ../../source/block_gallery/models/face_recognition_model.rst:17
msgid "输出（Output）: - 人脸框位置及置信度 - 人脸特征向量或匹配到的身份信息（如可用） - 推理是否成功、耗时"
msgstr ""
"Output: - Face frame position and confidence - Face feature vector or "
"matched identity information (if available) - Whether inference is "
"successful and time-consuming"

#: ../../source/block_gallery/models/face_recognition_model.rst:23
msgid "配置参数详解"
msgstr "Detailed explanation of configuration parameters"

