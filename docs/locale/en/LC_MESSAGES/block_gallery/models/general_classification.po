msgstr "Optional remark information to record the purpose."

#: ../../source/block_gallery/models/general_classification.rst:36
msgid "``留空``"
msgstr "``leave blank``"

#: ../../source/block_gallery/models/general_classification.rst:37
msgid "图像"
msgstr "image"

#: ../../source/block_gallery/models/general_classification.rst:38
