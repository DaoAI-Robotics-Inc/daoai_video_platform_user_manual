#: ../../source/block_gallery/models/daoai_world_mixed_model.rst:245
msgid "A: 需要同时包含多个任务标注的数据集。例如检测+分类模型需要："
msgstr ""
"A: A data set containing multiple task annotations is required.For example, "
"the detection + classification model requires:"

#: ../../source/block_gallery/models/daoai_world_mixed_model.rst:247
msgid "物体边界框标注"
msgstr "Object bounding box annotation"

#: ../../source/block_gallery/models/daoai_world_mixed_model.rst:248
msgid "物体类别标注"
msgstr "Object category annotation"

#: ../../source/block_gallery/models/daoai_world_mixed_model.rst:249
