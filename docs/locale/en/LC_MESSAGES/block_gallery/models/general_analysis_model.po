msgstr "Remark"

#: ../../source/block_gallery/models/general_analysis_model.rst:35
msgid "可选备注信息，记录用途。"
msgstr "Optional remark information to record the purpose."

#: ../../source/block_gallery/models/general_analysis_model.rst:36
msgid "``留空``"
msgstr "``leave blank``"

#: ../../source/block_gallery/models/general_analysis_model.rst:37
msgid "图像"
msgstr "image"

#: ../../source/block_gallery/models/general_analysis_model.rst:38
