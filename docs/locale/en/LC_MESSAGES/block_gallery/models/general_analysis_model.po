msgstr "Specify the input image source."

#: ../../source/block_gallery/models/general_analysis_model.rst:39
msgid "``input.image``"
msgstr "``input.image``"

#: ../../source/block_gallery/models/general_analysis_model.rst:40
msgid "属性标签"
msgstr "attribute tag"

#: ../../source/block_gallery/models/general_analysis_model.rst:41
msgid "需要分析/分类的属性列表，英文提示词，逗号分隔或 JSON 形式。"
msgstr ""
"List of attributes that need to be analyzed/classified, English prompt "
"words, comma separated or JSON format."

