msgid "节点名称"
msgstr "Node name"

#: ../../source/block_gallery/models/general_analysis_model.rst:32
msgid "工作流中该节点的名称。"
msgstr "The name of this node in the workflow."

#: ../../source/block_gallery/models/general_analysis_model.rst:33
