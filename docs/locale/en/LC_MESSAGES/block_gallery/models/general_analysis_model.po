#: ../../source/block_gallery/models/general_analysis_model.rst:4
msgid "通用分析模型"
msgstr "General analysis model"

#: ../../source/block_gallery/models/general_analysis_model.rst:7
msgid "简介"
msgstr "Introduction"

#: ../../source/block_gallery/models/general_analysis_model.rst:9
msgid "无需训练即可对检测到的物体进行属性分析/分类，适合快速搭建基于属性的筛选与分组场景。"
msgstr ""
"Attribute analysis/classification of detected objects can be performed "
"without training, which is suitable for quickly building attribute-based "
"filtering and grouping scenarios."

#: ../../source/block_gallery/models/general_analysis_model.rst:12
msgid "输入/输出"
msgstr "input/output"

#: ../../source/block_gallery/models/general_analysis_model.rst:14
msgid "输入（Input）: - 图像 / 视频帧（来自上游节点或工作流输入）"
msgstr "Input: - Image/video frame (from upstream node or workflow input)"

#: ../../source/block_gallery/models/general_analysis_model.rst:17
msgid "输出（Output）: - 检测到的物体属性分类结果及置信度 - 可选：Top-K 属性列表"
msgstr ""
"Output: - Detected object attribute classification results and confidence "
"level - Optional: Top-K attribute list"

#: ../../source/block_gallery/models/general_analysis_model.rst:22
msgid "配置参数详解"
msgstr "Detailed explanation of configuration parameters"

#: ../../source/block_gallery/models/general_analysis_model.rst:28
msgid "参数"
msgstr "parameter"

#: ../../source/block_gallery/models/general_analysis_model.rst:29
