msgstr ""
"The output of the OCR model contains all detected text and its details:"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:82
msgid "**字段说明：**"
msgstr "**Field description:**"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:84
msgid "``text``: 识别的文字内容"
msgstr "``text``: recognized text content"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:85
msgid "``confidence``: 识别置信度（0~1）"
msgstr "``confidence``: recognition confidence (0~1)"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:86
msgid "``bbox``: 文本边界框（矩形）"
msgstr "``bbox``: Text bounding box (rectangle)"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:88
msgid "``x``, ``y``: 左上角坐标"
msgstr "``x``, ``y``: coordinates of the upper left corner"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:89
msgid "``width``, ``height``: 宽度和高度"
msgstr "``width``, ``height``: width and height"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:91
msgid "``polygon``: 文本区域的精确多边形轮廓（支持倾斜文本）"
msgstr ""
"``polygon``: an exact polygonal outline of the text area (supports slanted "
"text)"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:92
msgid "``language``: 识别的语言类型"
msgstr "``language``: the recognized language type"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:93
msgid "``direction``: 文本方向（horizontal水平, vertical垂直）"
msgstr "``direction``: text direction (horizontal, vertical)"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:94
msgid "``text_id``: 文本块的唯一标识符"
msgstr "``text_id``: unique identifier of the text block"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:95
msgid "``full_text``: 所有文本按阅读顺序拼接的完整内容"
msgstr ""
"``full_text``: the complete content of all texts spliced ​​in reading order"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:96
msgid "``count``: 检测到的文本块总数"
msgstr "``count``: total number of text blocks detected"

#: ../../source/block_gallery/models/daoai_world_ocr.rst:97
msgid "``languages``: 图像中包含的所有语言"
msgstr "``languages``: all languages ​​contained in the image"

