{
    "name": "工地热人数统计",
    "category": "Construction Site",
    "notes": {
      "notes_cn": "使用通用目标检测模型检测图片区域中的人员数量。",
      "notes_en": "Use the general detection model to detect the number of people in the area of the image."
    },
    "definition": {
        "version": "1.0",
        "inputs": [
          {
            "type": "WorkflowImage",
            "name": "image"
          }
        ],
        "steps": [
          {
            "type": "daoai/general_obj_det@v1",
            "name": "general_object_detection_1",
            "comments": null,
            "images": "$inputs.image",
            "classes": [
              "person"
            ],
            "confidence_threshold": 0.5,
            "label_confidence_thresholds": null,
            "max_detections": 100
          },
          {
            "type": "core/detections_filter@v1",
            "name": "detections_filter_1",
            "comments": null,
            "predictions": "$steps.general_object_detection_1.predictions",
            "operations": [
              {
                "type": "DetectionsFilter",
                "filter_operation": {
                  "type": "StatementGroup",
                  "statements": [
                    {
                      "type": "BinaryStatement",
                      "left_operand": {
                        "type": "DynamicOperand",
                        "operations": [
                          {
                            "type": "ExtractDetectionProperty",
                            "property_name": "class_name"
                          }
                        ]
                      },
                      "comparator": {
                        "type": "in (Sequence)"
                      },
                      "right_operand": {
                        "type": "StaticOperand",
                        "value": [
                          "person"
                        ]
                      }
                    },
                    {
                      "type": "BinaryStatement",
                      "left_operand": {
                        "type": "DynamicOperand",
                        "operations": [
                          {
                            "type": "ExtractDetectionProperty",
                            "property_name": "confidence"
                          }
                        ]
                      },
                      "comparator": {
                        "type": "(Number) >="
                      },
                      "right_operand": {
                        "type": "StaticOperand",
                        "value": 0.5
                      }
                    }
                  ]
                }
              }
            ],
            "image": "$inputs.image",
            "uistate": {
              "operations": {
                "filterBy": "class_confidence",
                "parentClassName": "",
                "objectClassEnabled": true,
                "objectClassType": "include",
                "objectClasses": "person",
                "attributeEnabled": false,
                "attributeType": "include",
                "attributes": "",
                "confidenceEnabled": true,
                "confidenceOperator": ">=",
                "confidenceValue": 0.5,
                "imageInput": "$inputs.image",
                "detectionSizeOperator": "<=",
                "detectionSizeValue": 5,
                "detectionLocation": "in",
                "detectionReferencePoint": "center",
                "zoneDefinition": "Define in Editor",
                "zonePoints": [],
                "zoneJson": "[]"
              }
            }
          },
          {
            "type": "core/property_definition@v1",
            "name": "property_definition_1",
            "comments": null,
            "data": "$steps.detections_filter_1.predictions",
            "operations": [
              {
                "type": "SequenceLength"
              }
            ],
            "image": "$inputs.image"
          },
          {
            "type": "core/bounding_box_visualization@v1",
            "name": "bounding_box_visualization_1",
            "comments": null,
            "image": "$inputs.image",
            "copy_image": true,
            "predictions": "$steps.detections_filter_1.predictions",
            "color_palette": "DEFAULT",
            "palette_size": 10,
            "custom_colors": [],
            "color_axis": "CLASS",
            "thickness": 2,
            "roundness": 0
          },
          {
            "type": "core/label_visualization@v1",
            "name": "label_visualization_1",
            "comments": null,
            "image": "$steps.bounding_box_visualization_1.image",
            "copy_image": true,
            "predictions": "$steps.detections_filter_1.predictions",
            "color_palette": "DEFAULT",
            "palette_size": 10,
            "custom_colors": [],
            "color_axis": "CLASS",
            "text": "Index",
            "text_position": "TOP_LEFT",
            "text_color": "WHITE",
            "text_scale": 1,
            "text_thickness": 1,
            "text_padding": 10,
            "border_radius": 0
          },
          {
            "type": "daoai/event_saver@v1",
            "name": "event_saver_1",
            "comments": null,
            "event_type": "$steps.property_definition_1.output",
            "image": "$steps.label_visualization_1.image",
            "original_image": "$inputs.image",
            "save_video": true,
            "video_length_seconds": 30,
            "cooldown_seconds": 20,
            "cooldown_session_key": null,
            "per_type_cooldown_seconds": 30
          }
        ],
        "outputs": [
          {
            "name": "property_definition_1_1",
            "type": "JsonField",
            "selector": "$steps.property_definition_1.output"
          },
          {
            "name": "label_visualization_1",
            "type": "JsonField",
            "selector": "$steps.label_visualization_1.image"
          },
          {
            "type": "JsonField",
            "name": "event_saver_1_1",
            "coordinates_system": "own",
            "selector": "$steps.event_saver_1.error_status"
          },
          {
            "type": "JsonField",
            "name": "event_saver_1_2",
            "coordinates_system": "own",
            "selector": "$steps.event_saver_1.throttling_status"
          },
          {
            "type": "JsonField",
            "name": "event_saver_1_3",
            "coordinates_system": "own",
            "selector": "$steps.event_saver_1.message"
          },
          {
            "type": "JsonField",
            "name": "event_saver_1_4",
            "coordinates_system": "own",
            "selector": "$steps.event_saver_1.image_url"
          },
          {
            "type": "JsonField",
            "name": "event_saver_1_5",
            "coordinates_system": "own",
            "selector": "$steps.event_saver_1.video_url"
          }
        ]
      }
  }