              "type": "CasesDefinition",
              "default": {
                "type": "StaticCaseResult",
                "value": false
              },
              "cases": [
                {
                  "type": "CaseDefinition",
                  "condition": {
                    "type": "StatementGroup",
                    "statements": [
                      {
                        "type": "BinaryStatement",
                        "left_operand": {
                          "type": "DynamicOperand",
                          "operand_name": "para_1",
                          "operations": []
                        },
                        "comparator": {
                          "type": "=="
                        },
                        "right_operand": {
                          "type": "StaticOperand",
                          "value": true
                        }
                      }
                    ]
                  },
                  "result": {
                    "type": "StaticCaseResult",
                    "value": true
                  }
                }
              ]
            },
            "image": "$inputs.image"
          },
