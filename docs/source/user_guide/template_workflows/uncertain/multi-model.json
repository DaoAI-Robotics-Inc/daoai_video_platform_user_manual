{
    "name": "多模型逻辑检测",
    "category": "Uncertain",
    "notes": {
      "notes_cn": "支持多模型并行执行或串行执行，通过与 / 或逻辑组合，实现复杂条件判断与多层级结果输出，需要用户自行替换模型。",
      "notes_en": "Support parallel execution or serial execution of multiple models, through AND / OR logic combinations, to achieve complex condition judgment and multi-level result output, need to configure the model by yourself."
    },
    "definition": {
      "version": "1.0",
      "inputs": [
        {
          "type": "WorkflowImage",
          "name": "image"
        }
      ],
      "steps": [
        {
          "type": "daoai/daoai_world_model@v1",
          "name": "daoai_world_model_1",
          "comments": null,
          "images": "$inputs.image",
          "model_type": "detection",
          "model_uid": "CcaHeNg6gLrjg1rFqtA_EA",
          "confidence_threshold": null,
          "label_confidence_thresholds": null
        },
        {
          "type": "core/detections_filter@v1",
          "name": "detections_filter_1",
          "comments": null,
          "predictions": "$steps.general_object_detection_1.predictions",
          "operations": [
            {
              "type": "DetectionsFilter",
              "filter_operation": {
                "type": "StatementGroup",
                "statements": [
                  {
                    "type": "BinaryStatement",
                    "left_operand": {
                      "type": "DynamicOperand",
                      "operations": [
                        {
                          "type": "ExtractDetectionProperty",
                          "property_name": "class_name"
                        }
                      ]
                    },
                    "comparator": {
                      "type": "in (Sequence)"
                    },
                    "right_operand": {
                      "type": "StaticOperand",
                      "value": [
                        "car"
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "image": "$inputs.image",
          "uistate": {
            "operations": {
              "filterBy": "class_confidence",
              "parentClassName": "",
              "objectClassEnabled": true,
              "objectClassType": "include",
              "objectClasses": "car",
              "attributeEnabled": false,
              "attributeType": "include",
              "attributes": "",
              "confidenceEnabled": false,
              "confidenceOperator": ">=",
              "confidenceValue": 0.5,
              "imageInput": "$inputs.image",
              "detectionSizeOperator": "<=",
              "detectionSizeValue": 5,
              "detectionLocation": "in",
              "detectionReferencePoint": "center",
              "zoneDefinition": "Define in Editor",
              "zonePoints": [],
              "zoneJson": "[]"
            }
          }
        },
        {
          "type": "core/continue_if@v1",
          "name": "continue_if_1",
          "comments": null,
          "condition_statement": {
            "type": "StatementGroup",
            "statements": [
              {
                "type": "BinaryStatement",
                "left_operand": {
                  "type": "DynamicOperand",
                  "operand_name": "left",
                  "operations": [
                    {
                      "type": "SequenceLength"
                    }
                  ]
                },
                "comparator": {
                  "type": "(Number) >="
                },
                "right_operand": {
                  "type": "StaticOperand",
                  "value": 1
                }
              }
            ],
            "operator": "and",
            "uistate": {
              "leftOperand": "$steps.detections_filter_1.predictions",
              "detectionsEvaluationProperty": "detection_count",
              "selectedFilterType": "not_selected",
              "isClassFilteringActive": false,
              "isAttrFilteringActive": false,
              "isConfidenceFilteringActive": false,
              "classSetInclusionMode": "include",
              "classList": [],
              "attrList": [],
              "attrSetInclusionMode": "include",
              "confidenceThreshold": 0.5,
              "confidenceOperator": ">=",
              "referenceImage": null,
              "sizeThreshold": 5,
              "sizeThresholdOperator": "<=",
              "zoneOperator": "in",
              "zonePoints": [],
              "detectionReferencePoint": "center",
              "isZoneStatic": true,
              "dynamicZone": null,
              "runtimeParameter": null,
              "parentClassName": "",
              "confidenceAggregationMode": "max",
              "confidenceAggregationOperator": ">=",
              "confidenceAggregationThreshold": 0.5,
              "comparator": "(Number) ==",
              "comparisonType": "Statically",
              "comparisonValue": "0",
              "detectionsNumberOperator": "(Number) >=",
              "detectionsNumberThreshold": 1,
              "extractedImageProperty": "height",
              "propertyValueOperator": ">=",
              "referenceValue": 1,
              "isReferenceValueStatic": true,
              "nonImageInputOperation": "(Number) ==",
              "isMultiLabel": false,
              "multiLabelOperation": "==",
              "isFilteringEnabled": false
            }
          },
          "evaluation_parameters": {
            "left": "$steps.detections_filter_1.predictions"
          },
          "next_steps": [
            "$steps.dynamic_crop_1"
          ],
          "image": "$inputs.image"
        },
        {
          "type": "core/dynamic_crop@v1",
          "name": "dynamic_crop_1",
          "comments": null,
          "images": "$inputs.image",
          "predictions": "$steps.detections_filter_1.predictions",
          "mask_opacity": 0,
          "background_color": [
            0,
            0,
            0
          ],
          "image": "$inputs.image"
        },
        {
          "type": "daoai/daoai_world_model@v1",
          "name": "daoai_world_model_2",
          "comments": null,
          "images": "$steps.dynamic_crop_1.crops",
          "model_type": "classification",
          "model_uid": "1P70R27Ubofnbh0D0sHWxA",
          "confidence_threshold": null,
          "label_confidence_thresholds": null,
          "image": "$inputs.image"
        },
        {
          "type": "core/detections_filter@v1",
          "name": "detections_filter_2",
          "comments": null,
          "predictions": "$steps.general_object_detection_1.predictions",
          "operations": [
            {
              "type": "DetectionsFilter",
              "filter_operation": {
                "type": "StatementGroup",
                "statements": [
                  {
                    "type": "BinaryStatement",
                    "left_operand": {
                      "type": "DynamicOperand",
                      "operations": [
                        {
                          "type": "ExtractDetectionProperty",
                          "property_name": "class_name"
                        }
                      ]
                    },
                    "comparator": {
                      "type": "in (Sequence)"
                    },
                    "right_operand": {
                      "type": "StaticOperand",
                      "value": [
                        "people"
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "image": "$inputs.image",
          "uistate": {
            "operations": {
              "filterBy": "class_confidence",
              "parentClassName": "",
              "objectClassEnabled": true,
              "objectClassType": "include",
              "objectClasses": "people",
              "attributeEnabled": false,
              "attributeType": "include",
              "attributes": "",
              "confidenceEnabled": false,
              "confidenceOperator": ">=",
              "confidenceValue": 0.5,
              "imageInput": "$inputs.image",
              "detectionSizeOperator": "<=",
              "detectionSizeValue": 5,
              "detectionLocation": "in",
              "detectionReferencePoint": "center",
              "zoneDefinition": "Define in Editor",
              "zonePoints": [],
              "zoneJson": "[]"
            }
          }
        },
        {
          "type": "core/continue_if@v1",
          "name": "continue_if_2",
          "comments": null,
          "condition_statement": {
            "type": "StatementGroup",
            "statements": [
              {
                "type": "BinaryStatement",
                "left_operand": {
                  "type": "DynamicOperand",
                  "operand_name": "left",
                  "operations": [
                    {
                      "type": "SequenceLength"
                    }
                  ]
                },
                "comparator": {
                  "type": "(Number) >="
                },
                "right_operand": {
                  "type": "StaticOperand",
                  "value": 1
                }
              }
            ],
            "operator": "and",
            "uistate": {
              "leftOperand": "$steps.detections_filter_2.predictions",
              "detectionsEvaluationProperty": "detection_count",
              "selectedFilterType": "not_selected",
              "isClassFilteringActive": false,
              "isAttrFilteringActive": false,
              "isConfidenceFilteringActive": false,
              "classSetInclusionMode": "include",
              "classList": [],
              "attrList": [],
              "attrSetInclusionMode": "include",
              "confidenceThreshold": 0.5,
              "confidenceOperator": ">=",
              "referenceImage": null,
              "sizeThreshold": 5,
              "sizeThresholdOperator": "<=",
              "zoneOperator": "in",
              "zonePoints": [],
              "detectionReferencePoint": "center",
              "isZoneStatic": true,
              "dynamicZone": null,
              "runtimeParameter": null,
              "parentClassName": "",
              "confidenceAggregationMode": "max",
              "confidenceAggregationOperator": ">=",
              "confidenceAggregationThreshold": 0.5,
              "comparator": "(Number) ==",
              "comparisonType": "Statically",
              "comparisonValue": "0",
              "detectionsNumberOperator": "(Number) >=",
              "detectionsNumberThreshold": 1,
              "extractedImageProperty": "height",
              "propertyValueOperator": ">=",
              "referenceValue": 1,
              "isReferenceValueStatic": true,
              "nonImageInputOperation": "(Number) ==",
              "isMultiLabel": false,
              "multiLabelOperation": "==",
              "isFilteringEnabled": false
            }
          },
          "evaluation_parameters": {
            "left": "$steps.detections_filter_2.predictions"
          },
          "next_steps": [
            "$steps.dynamic_crop_2"
          ],
          "image": "$inputs.image"
        },
        {
          "type": "core/dynamic_crop@v1",
          "name": "dynamic_crop_2",
          "comments": null,
          "images": "$inputs.image",
          "predictions": "$steps.detections_filter_2.predictions",
          "mask_opacity": 0,
          "background_color": [
            0,
            0,
            0
          ],
          "image": "$inputs.image"
        },
        {
          "type": "daoai/daoai_world_model@v1",
          "name": "daoai_world_model_3",
          "comments": null,
          "images": "$steps.dynamic_crop_2.crops",
          "model_type": "classification",
          "model_uid": "1P70R27Ubofnbh0D0sHWxA",
          "confidence_threshold": null,
          "label_confidence_thresholds": null,
          "image": "$inputs.image"
        },
        {
          "type": "core/detections_classes_replacement@v1",
          "name": "detections_classes_replacement_1",
          "comments": null,
          "object_detection_predictions": "$steps.general_object_detection_1.predictions",
          "classification_predictions": "$steps.daoai_world_model_2.predictions",
          "fallback_class_name": "unknown",
          "fallback_class_id": null,
          "image": "$inputs.image"
        },
        {
          "type": "core/detections_classes_replacement@v1",
          "name": "detections_classes_replacement_2",
          "comments": null,
          "object_detection_predictions": "$steps.general_object_detection_1.predictions",
          "classification_predictions": "$steps.daoai_world_model_3.predictions",
          "fallback_class_name": null,
          "fallback_class_id": null,
          "image": "$inputs.image"
        },
        {
          "type": "core/detections_combine@v1",
          "name": "detections_combine_1",
          "comments": null,
          "prediction_one": "$steps.detections_combine_2.predictions",
          "prediction_two": "$steps.detections_classes_replacement_2.predictions",
          "image": "$inputs.image"
        },
        {
          "type": "core/bounding_box_visualization@v1",
          "name": "bounding_box_visualization_1",
          "comments": null,
          "image": "$inputs.image",
          "copy_image": true,
          "predictions": "$steps.detections_combine_1.predictions",
          "color_palette": "DEFAULT",
          "palette_size": 10,
          "custom_colors": [],
          "color_axis": "CLASS",
          "thickness": 2,
          "roundness": 0
        },
        {
          "type": "core/label_visualization@v1",
          "name": "label_visualization_1",
          "comments": null,
          "image": "$steps.bounding_box_visualization_1.image",
          "copy_image": true,
          "predictions": "$steps.detections_combine_1.predictions",
          "color_palette": "DEFAULT",
          "palette_size": 10,
          "custom_colors": [],
          "color_axis": "CLASS",
          "text": "Class",
          "text_position": "TOP_LEFT",
          "text_color": "WHITE",
          "text_scale": 1,
          "text_thickness": 1,
          "text_padding": 10,
          "border_radius": 0
        },
        {
          "type": "daoai/general_obj_det@v1",
          "name": "general_object_detection_1",
          "comments": null,
          "images": "$inputs.image",
          "classes": [
            "car",
            "people"
          ],
          "confidence_threshold": 0.25,
          "label_confidence_thresholds": null,
          "max_detections": 100,
          "image": "$inputs.image"
        },
        {
          "type": "core/detections_combine@v1",
          "name": "detections_combine_2",
          "comments": null,
          "prediction_one": "$steps.detections_classes_replacement_1.predictions",
          "prediction_two": "$steps.daoai_world_model_1.predictions",
          "image": "$inputs.image"
        }
      ],
      "outputs": [
        {
          "type": "JsonField",
          "name": "daoai_world_model_1_1",
          "coordinates_system": "own",
          "selector": "$steps.daoai_world_model_1.predictions"
        },
        {
          "type": "JsonField",
          "name": "detections_filter_1_1",
          "coordinates_system": "own",
          "selector": "$steps.detections_filter_1.predictions"
        },
        {
          "type": "JsonField",
          "name": "dynamic_crop_1_1",
          "coordinates_system": "own",
          "selector": "$steps.dynamic_crop_1.crops"
        },
        {
          "type": "JsonField",
          "name": "dynamic_crop_1_2",
          "coordinates_system": "own",
          "selector": "$steps.dynamic_crop_1.predictions"
        },
        {
          "type": "JsonField",
          "name": "daoai_world_model_2_1",
          "coordinates_system": "own",
          "selector": "$steps.daoai_world_model_2.predictions"
        },
        {
          "type": "JsonField",
          "name": "detections_filter_2_1",
          "coordinates_system": "own",
          "selector": "$steps.detections_filter_2.predictions"
        },
        {
          "type": "JsonField",
          "name": "dynamic_crop_2_1",
          "coordinates_system": "own",
          "selector": "$steps.dynamic_crop_2.crops"
        },
        {
          "type": "JsonField",
          "name": "dynamic_crop_2_2",
          "coordinates_system": "own",
          "selector": "$steps.dynamic_crop_2.predictions"
        },
        {
          "type": "JsonField",
          "name": "daoai_world_model_3_1",
          "coordinates_system": "own",
          "selector": "$steps.daoai_world_model_3.predictions"
        },
        {
          "type": "JsonField",
          "name": "detections_classes_replacement_1_1",
          "coordinates_system": "own",
          "selector": "$steps.detections_classes_replacement_1.predictions"
        },
        {
          "type": "JsonField",
          "name": "detections_classes_replacement_2_1",
          "coordinates_system": "own",
          "selector": "$steps.detections_classes_replacement_2.predictions"
        },
        {
          "type": "JsonField",
          "name": "detections_combine_1_1",
          "coordinates_system": "own",
          "selector": "$steps.detections_combine_1.predictions"
        },
        {
          "type": "JsonField",
          "name": "bounding_box_visualization_1_1",
          "coordinates_system": "own",
          "selector": "$steps.bounding_box_visualization_1.image"
        },
        {
          "type": "JsonField",
          "name": "label_visualization_1_1",
          "coordinates_system": "own",
          "selector": "$steps.label_visualization_1.image"
        },
        {
          "type": "JsonField",
          "name": "general_object_detection_1_1",
          "coordinates_system": "own",
          "selector": "$steps.general_object_detection_1.predictions"
        },
        {
          "type": "JsonField",
          "name": "detections_combine_2_1",
          "coordinates_system": "own",
          "selector": "$steps.detections_combine_2.predictions"
        }
      ]
    }
}