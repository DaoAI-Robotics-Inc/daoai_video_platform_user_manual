{
    "name": "离岗检测",
    "category": "Office",
    "notes": {
      "notes_cn": "识别目标人员是否离开指定办公区域，用于监控员工离岗或值班空缺，需要用户自行配置区域坐标。",
      "notes_en": "Detect whether the target person has left the specified office area, used to monitor employee absenteeism, need to configure the region coordinates by yourself."
    },
    "definition": {
      "version": "1.0",
      "inputs": [
        {
          "type": "WorkflowImage",
          "name": "image"
        }
      ],
      "steps": [
        {
          "type": "daoai/general_obj_det@v1",
          "name": "general_object_detection_1",
          "comments": null,
          "images": "$inputs.image",
          "classes": [
            "person"
          ],
          "confidence_threshold": 0.5,
          "label_confidence_thresholds": null,
          "max_detections": 100
        },
        {
          "type": "core/detections_filter@v1",
          "name": "detections_filter_1",
          "comments": null,
          "predictions": "$steps.detections_filter_2.predictions",
          "operations": [
            {
              "type": "DetectionsFilter",
              "filter_operation": {
                "type": "StatementGroup",
                "statements": [
                  {
                    "type": "BinaryStatement",
                    "left_operand": {
                      "type": "DynamicOperand",
                      "operations": [
                        {
                          "type": "ExtractDetectionProperty",
                          "property_name": "class_name"
                        }
                      ]
                    },
                    "comparator": {
                      "type": "in (Sequence)"
                    },
                    "right_operand": {
                      "type": "StaticOperand",
                      "value": [
                        "person"
                      ]
                    }
                  },
                  {
                    "type": "BinaryStatement",
                    "left_operand": {
                      "type": "DynamicOperand",
                      "operations": [
                        {
                          "type": "ExtractDetectionProperty",
                          "property_name": "confidence"
                        }
                      ]
                    },
                    "comparator": {
                      "type": "(Number) >="
                    },
                    "right_operand": {
                      "type": "StaticOperand",
                      "value": 0.5
                    }
                  }
                ]
              }
            }
          ],
          "image": "$inputs.image",
          "uistate": {
            "operations": {
              "filterBy": "class_confidence",
              "parentClassName": "",
              "objectClassEnabled": true,
              "objectClassType": "include",
              "objectClasses": "person",
              "attributeEnabled": false,
              "attributeType": "include",
              "attributes": "",
              "confidenceEnabled": true,
              "confidenceOperator": ">=",
              "confidenceValue": 0.5,
              "imageInput": "$inputs.image",
              "detectionSizeOperator": "<=",
              "detectionSizeValue": 5,
              "detectionLocation": "in",
              "detectionReferencePoint": "center",
              "zoneDefinition": "Define in Editor",
              "zonePoints": [],
              "zoneJson": "[]"
            }
          }
        },
        {
          "type": "daoai/event_saver@v1",
          "name": "event_saver_1",
          "comments": null,
          "event_type": "Personnel leaving their posts",
          "image": "$steps.polygon_zone_visualization_1.image",
          "original_image": "$inputs.image",
          "save_video": true,
          "video_length_seconds": 15,
          "cooldown_seconds": 20,
          "cooldown_session_key": null,
          "per_type_cooldown_seconds": 15
        },
        {
          "type": "core/detections_filter@v1",
          "name": "detections_filter_2",
          "comments": null,
          "predictions": "$steps.general_object_detection_1.predictions",
          "operations": [
            {
              "type": "DetectionsFilter",
              "filter_operation": {
                "type": "StatementGroup",
                "statements": []
              }
            }
          ],
          "image": "$inputs.image",
          "uistate": {
            "operations": {
              "filterBy": "zone",
              "parentClassName": "",
              "objectClassEnabled": false,
              "objectClassType": "include",
              "objectClasses": "",
              "attributeEnabled": false,
              "attributeType": "include",
              "attributes": "",
              "confidenceEnabled": false,
              "confidenceOperator": ">=",
              "confidenceValue": 0.5,
              "imageInput": "$inputs.image",
              "detectionSizeOperator": "<=",
              "detectionSizeValue": 5,
              "detectionLocation": "in",
              "detectionReferencePoint": "center",
              "zoneDefinition": "Define in Editor",
              "zonePoints": [],
              "zoneJson": "[]"
            }
          }
        },
        {
          "type": "daoai/highway_tracker@v1",
          "name": "highway_tracker_1",
          "comments": null,
          "image": "$inputs.image",
          "detections": "$steps.detections_filter_1.predictions",
          "track_activation_threshold": 0.5,
          "lost_track_buffer": 15,
          "minimum_matching_threshold": 0.3,
          "minimum_consecutive_frames": 1,
          "instances_cache_size": 16384
        },
        {
          "type": "daoai/time_out_zone@v1",
          "name": "time_out_of_zone_1",
          "comments": null,
          "image": "$inputs.image",
          "detections": "$steps.highway_tracker_1.already_seen_instances",
          "zone": [],
          "triggering_anchor": "CENTER",
          "remove_in_zone_detections": true,
          "target_label": null
        },
        {
          "type": "core/property_definition@v1",
          "name": "property_definition_1",
          "comments": null,
          "data": "$steps.time_out_of_zone_1.timed_detections",
          "operations": [
            {
              "type": "DetectionsPropertyExtract",
              "property_name": "time_out_of_zone"
            },
            {
              "type": "NumericSequenceAggregate",
              "function": "max"
            }
          ],
          "image": "$inputs.image"
        },
        {
          "type": "core/continue_if@v1",
          "name": "continue_if_1",
          "comments": null,
          "condition_statement": {
            "type": "StatementGroup",
            "statements": [
              {
                "type": "BinaryStatement",
                "left_operand": {
                  "type": "DynamicOperand",
                  "operand_name": "left"
                },
                "comparator": {
                  "type": "(Number) >="
                },
                "right_operand": {
                  "type": "StaticOperand",
                  "value": 15
                }
              }
            ],
            "operator": "and",
            "uistate": {
              "leftOperand": "$steps.property_definition_1.output",
              "detectionsEvaluationProperty": "value",
              "selectedFilterType": "not_selected",
              "isClassFilteringActive": false,
              "isAttrFilteringActive": false,
              "isConfidenceFilteringActive": false,
              "classSetInclusionMode": "include",
              "classList": [],
              "attrList": [],
              "attrSetInclusionMode": "include",
              "confidenceThreshold": 0.5,
              "confidenceOperator": ">=",
              "referenceImage": null,
              "sizeThreshold": 5,
              "sizeThresholdOperator": "<=",
              "zoneOperator": "in",
              "zonePoints": [],
              "detectionReferencePoint": "center",
              "isZoneStatic": true,
              "dynamicZone": null,
              "runtimeParameter": null,
              "parentClassName": "",
              "confidenceAggregationMode": "max",
              "confidenceAggregationOperator": ">=",
              "confidenceAggregationThreshold": 0.5,
              "comparator": "(Number) ==",
              "comparisonType": "Statically",
              "comparisonValue": "0",
              "detectionsNumberOperator": "(Number) >=",
              "detectionsNumberThreshold": 30,
              "extractedImageProperty": "height",
              "propertyValueOperator": ">=",
              "referenceValue": 30,
              "isReferenceValueStatic": true,
              "nonImageInputOperation": "(Number) ==",
              "isMultiLabel": false,
              "multiLabelOperation": "==",
              "isFilteringEnabled": false
            }
          },
          "evaluation_parameters": {
            "left": "$steps.property_definition_1.output"
          },
          "next_steps": [
            "$steps.polygon_zone_visualization_1"
          ],
          "image": "$inputs.image"
        },
        {
          "type": "core/polygon_zone_visualization@v1",
          "name": "polygon_zone_visualization_1",
          "comments": null,
          "image": "$inputs.image",
          "copy_image": true,
          "zone": [],
          "color": "#F00",
          "opacity": 0.3
        },
        {
          "type": "daoai/dashboard_visualization@v1",
          "name": "dashboard_visualization_1",
          "comments": null,
          "image": "$steps.polygon_zone_visualization_1.image"
        }
      ],
      "outputs": [
        {
          "type": "JsonField",
          "name": "event_saver_1_1",
          "coordinates_system": "own",
          "selector": "$steps.event_saver_1.error_status"
        },
        {
          "type": "JsonField",
          "name": "event_saver_1_2",
          "coordinates_system": "own",
          "selector": "$steps.event_saver_1.throttling_status"
        },
        {
          "type": "JsonField",
          "name": "event_saver_1_3",
          "coordinates_system": "own",
          "selector": "$steps.event_saver_1.message"
        },
        {
          "type": "JsonField",
          "name": "event_saver_1_4",
          "coordinates_system": "own",
          "selector": "$steps.event_saver_1.image_url"
        },
        {
          "type": "JsonField",
          "name": "event_saver_1_5",
          "coordinates_system": "own",
          "selector": "$steps.event_saver_1.video_url"
        },
        {
          "type": "JsonField",
          "name": "detections_filter_2_1",
          "coordinates_system": "own",
          "selector": "$steps.detections_filter_2.predictions"
        },
        {
          "type": "JsonField",
          "name": "highway_tracker_1_1",
          "coordinates_system": "own",
          "selector": "$steps.highway_tracker_1.tracked_detections"
        },
        {
          "type": "JsonField",
          "name": "highway_tracker_1_2",
          "coordinates_system": "own",
          "selector": "$steps.highway_tracker_1.new_instances"
        },
        {
          "type": "JsonField",
          "name": "highway_tracker_1_3",
          "coordinates_system": "own",
          "selector": "$steps.highway_tracker_1.already_seen_instances"
        },
        {
          "type": "JsonField",
          "name": "time_out_of_zone_1_1",
          "coordinates_system": "own",
          "selector": "$steps.time_out_of_zone_1.timed_detections"
        },
        {
          "type": "JsonField",
          "name": "property_definition_1_1",
          "coordinates_system": "own",
          "selector": "$steps.property_definition_1.output"
        },
        {
          "type": "JsonField",
          "name": "polygon_zone_visualization_1_1",
          "coordinates_system": "own",
          "selector": "$steps.polygon_zone_visualization_1.image"
        }
      ]
    }
  }